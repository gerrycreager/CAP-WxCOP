  <!-- ═══ Tilesets ═══
       ts dimension: "current" (live frame) or an explicit YYYYMMDD-HHMMSS
       frame timestamp, passed straight through to the backend's own ts=
       param (same name, no remapping needed). Tile cache lifetime is
       4h per operational policy; raw MRMS/satellite data are retained
       36h for incident documentation, but rendered tiles don't need to
       outlive an active mission. -->

  <tileset name="composite">
    <metadata><title>MRMS Composite Reflectivity</title></metadata>
    <source>composite</source>
    <cache>disk</cache>
    <format>PNG</format>
    <grid>WGS84</grid>
    <grid>GoogleMapsCompatible</grid>
    <expires>14400</expires>
    <dimensions>
      <dimension name="ts" type="sqlite" default="current">
        <dbfile>/var/cache/mapcache/dims.sqlite</dbfile>
        <validate_query>SELECT ts FROM frames WHERE tileset = :tileset AND ts = :dim</validate_query>
        <list_query>SELECT ts FROM frames WHERE tileset = :tileset ORDER BY ts</list_query>
      </dimension>
    </dimensions>
  </tileset>

