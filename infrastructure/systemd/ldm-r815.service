[Unit]
Description=Unidata LDM Data Manager (r815 - relay mode)
Documentation=https://www.unidata.ucar.edu/software/ldm/
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=ldm
Group=ldm

ExecStartPre=/home/ldm/bin/ldmadmin queuecheck
ExecStart=/home/ldm/bin/ldmadmin start
ExecStop=/home/ldm/bin/ldmadmin stop
ExecReload=/home/ldm/bin/ldmadmin restart

PIDFile=/home/ldm/ldmd.pid

Restart=on-failure
RestartSec=30
TimeoutStartSec=60
TimeoutStopSec=30

Environment="PATH=/home/ldm/bin:/home/ldm/util:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="LDMHOME=/home/ldm"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ldm

[Install]
WantedBy=multi-user.target
