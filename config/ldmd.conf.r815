##
## LDM Configuration File - ldmd.conf
## Requesting data from idd.wisc.edu
##

# Hostname and contact information
#hostname ldm-cap.n5jxs.ampr.org
#email ldmadmin@n5jxs.ampr.org

# Maximum queue size (bytes) - adjust based on your needs
#queue-path /home/ldm/var/queues/ldm.pq
#queue-size 5G

# Log file location
#log-path /home/ldm/var/logs/ldmd.log

###############################################################################
# Exec Entries
###############################################################################
# Execute pqact for each feedtype
EXEC	"pqact -f IDS|DDPLUS /home/ldm/etc/pqact_text.conf"
#EXEC	"pqact -f SATELLITE /home/ldm/etc/pqact_satellite.conf"
#EXEC	"pqact -f NEXRAD2 /home/ldm/etc/pqact_nexrad2.conf"
#EXEC	"pqact -v -l /home/ldm/var/logs/pqact-n3.log -f NEXRAD3 /home/ldm/etc/pqact_nexrad3.conf"
#EXEC	"pqact -f NGRID /home/ldm/etc/pqact_ngrid.conf"
#EXEC	"pqact -f CONDUIT /home/ldm/etc/pqact_conduit.conf"
EXEC	"pqact -f IDS|DDPLUS /home/ldm/etc/pqact_fire.conf"
#EXEC	"pqact -f EXP /home/ldm/etc/pqact_mrms.conf"
#EXEC	"pqact -f DIFAX /home/ldm/etc/pqact_satellite.conf"

# rtstats uses the LDM to send product latency statistics to the UPC.
EXEC	"rtstats -h rtstats.unidata.ucar.edu"

###############################################################################
# Request Entries
###############################################################################
# Request text products (METAR, AIRMET, SIGMET, Watches, Warnings)
REQUEST	IDS|DDPLUS	".*"	idd.aos.wisc.edu

# Request GOES-East and GOES-West satellite data
###REQUEST		SATELLITE	".*"	idd.aos.wisc.edu
REQUEST		SATELLITE	"^/data/cspp-geo/.*/OR_(ABI-L1b-Rad[CF]-M6C(08|13)_G(1[89])_|GLM)"	idd.aos.wisc.edu
###REQUEST		DIFAX		".*"	idd.aos.wisc.edu

# Request NEXRAD Level II data
#REQUEST	NEXRAD2	".*"	idd.aos.wisc.edu

# Request NEXRAD Level III data
REQUEST NEXRAD3 ".*"	idd.aos.wisc.edu
#REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?N0Q" idd.aos.wisc.edu
#REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?N0U" idd.aos.wisc.edu
#REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?N0S" idd.aos.wisc.edu
#REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?N1P" idd.aos.wisc.edu
#REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?NTP" idd.aos.wisc.edu
#REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?DVL" idd.aos.wisc.edu
#REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?NET" idd.aos.wisc.edu
###REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?NCR" idd.aos.wisc.edu
###REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?FTM" idd.aos.wisc.edu
###REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?N0H" idd.aos.wisc.edu
###REQUEST NEXRAD3 "^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/?p?N0B" idd.aos.wisc.edu
#REQUEST	NEXRAD3	"^SDUS[2-8]. .... [0-3][0-9][0-2][0-9][0-5][0-9].*/p..." idd.aos.wisc.edu

# Request MRMS from NOAA TOC
REQUEST		EXP	".*"	mrms-ldmout.ncep.noaa.gov
#REQUEST	EXP	"realtime/outgoing/grib2/CONUS/MRMS_MergedReflectivityQC_.*_.*.grib2.gz"	mrms-ldmout.ncep.noaa.gov
#REQUEST	EXP	"realtime/outgoing/grib2/CONUSPLUS/MRMS_MergedReflectivityQC_.*_.*.grib2.gz"	mrms-ldmout.ncep.noaa.gov
###REQUEST	EXP	"realtime/outgoing/grib2/CONUS/MRMS_MergedReflectivityQComposite_.*_.*.grib2.gz"	mrms-ldmout.ncep.noaa.gov
###REQUEST	EXP	"realtime/outgoing/grib2/.*/MRMS_MESH_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov
#REQUEST	EXP	"realtime/outgoing/grib2/.*/MRMS_HeightLowLevelCompositeReflectivity_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov
###REQUEST	EXP	"realtime/outgoing/grib2/.*/MRMS_LayerCompositeReflectivity_Super_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov
#REQUEST	EXP	"realtime/outgoing/grib2/.*/MRMS_ReflectivityAtLowestAltitude_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov
#REQUEST	EXP	"realtime/outgoing/grib2/.*/RMS_FLASH_QPE_ARI.*_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov
###REQUEST	EXP	"realtime/outgoing/grib2/.*/MRMS_LightningProbabilityNext60minGrid_scale_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov
#REQUEST	EXP	"realtime/outgoing/grib2/.*/MRMS_SHI_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov
#REQUEST	EXP	"realtime/outgoing/grib2/.*/_.*_.*.grib2.gz"        mrms-ldmout.ncep.noaa.gov

# Request HRRR model data
REQUEST		NGRID	"HRRR"	idd.aos.wisc.edu

# Request LAMP data
REQUEST		NGRID	".*"	idd.aos.wisc.edu
REQUEST		HDS	".*"	idd.aos.wisc.edu

# Request GFS model data
#REQUEST	CONDUIT	".*gfs.*pgrb2\.0p25.*"	idd.aos.wisc.edu
#Lock down the GFS request to f000-f048: We're getting too many files 
REQUEST	CONDUIT	".*gfs\.t[0-9][0-9]z\.pgrb2\.0p25\.f0(0[0-9]|[1-4][0-9])"	idd.aos.wisc.edu

#REQUEST	CONDUIT	".*aigfs/.*"		idd.aos.wisc.edu
#REQUEST	CONDUIT	".*aigefs/.*"		idd.aos.wisc.edu
#REQUEST	CONDUIT	".*hgefs/.*"	idd.aos.wisc.edu
# AIGFS — limit to F000-F048 at 6-hour steps, wind/temp variables only
REQUEST  CONDUIT  ".*aigfs\.t[0-9][0-9]z\..*\.f0(0[0-9]|[1-4][0-9])"  idd.aos.wisc.edu

# AIGEFS — comment out until WxCOP has a use case for ensemble OCONUS
#REQUEST  CONDUIT  ".*aigefs/.*"  idd.aos.wisc.edu

# HGEFS — comment out until hurricane season and only if actively used
#REQUEST  CONDUIT  ".*hgefs/.*"  idd.aos.wisc.edu

# NAM for AK/HI/GU/CARIB -- Request all for now. 
REQUEST		CONDUIT	".*nam\.t[01][0-8]\.hawaiinest\.hires.*" 	idd.aos.wisc.edu
REQUEST		CONDUIT	".*nam\.t[01][0-8]\.alaskanest\.hires.*" 	idd.aos.wisc.edu
REQUEST		CONDUIT	".*nam\.t[01][0-8]\.afwa.*" 	idd.aos.wisc.edu
REQUEST		CONDUIT	".*nam\.t[01][0-8]\.priconest.*"	idd.aos.wisc.edu

###############################################################################
# Allow Entries
###############################################################################
# Under no circumstances comment out the next allow entry to localhost
ALLOW	ANY	^((localhost|loopback)|(127\.0\.0\.1\.?))$

# Give permission to the Unidata Program Center
ALLOW	ANY	^[a-z].*\.unidata\.ucar\.edu\.?$

# Allow anything on the LAN
ALLOW	ANY	^192\.168\.0\.61$
ALLOW	ANY	^192\.168\.0\.60$
ALLOW	ANY	^(192\.168\.0\.*)$
ALLOW	WMO|NEXRAD3	^54\.247\.205\.108$


